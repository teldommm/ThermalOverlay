<?xml version="1.0" encoding="utf-8"?>
<!-- Open list: its own surface so it stands out from the card behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/popup_bg" />
    <stroke android:width="1dp" android:color="@color/spinner_stroke" />
    <corners android:radius="10dp" />
    <padding
        android:left="0dp"
        android:top="4dp"
        android:right="0dp"
        android:bottom="4dp" />
</shape>
