<?xml version="1.0" encoding="utf-8"?>
<!-- Closed picker: a slightly lighter, thin-outlined field with a chevron. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/spinner_bg" />
            <stroke android:width="1dp" android:color="@color/spinner_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:width="18dp"
        android:height="18dp"
        android:gravity="end|center_vertical"
        android:end="8dp"
        android:drawable="@drawable/ic_spinner_arrow" />
</layer-list>
