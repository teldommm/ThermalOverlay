<?xml version="1.0" encoding="utf-8"?>
<!-- Text field: the picker's look, with an accent outline while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/spinner_bg" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/spinner_bg" />
            <stroke android:width="1dp" android:color="@color/spinner_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
