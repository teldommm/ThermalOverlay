<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/freq_gpu_title"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/gpu_current_freq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="14dp"
        tools:text="cur: 587 MHz" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/freq_governor_label"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/gpu_spinner_governor"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/bg_spinner"
        android:popupBackground="@drawable/bg_spinner_popup"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/freq_min_label"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/gpu_spinner_min_freq"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/bg_spinner"
        android:popupBackground="@drawable/bg_spinner_popup"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/freq_max_label"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/gpu_spinner_max_freq"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/bg_spinner"
        android:popupBackground="@drawable/bg_spinner_popup"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/freq_adreno_boost_label"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/gpu_spinner_adreno_boost"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/bg_spinner"
        android:popupBackground="@drawable/bg_spinner_popup"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="32dp" />

    <!-- Default power level: label, live value on the right, slider and a
         caption under each end saying which end is faster. Level 0 is the
         fastest GPU state, the highest number the slowest. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/freq_pwrlevel_default"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/gpu_default_pwrlevel_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:minWidth="24dp"
            android:gravity="end"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="3" />

    </LinearLayout>

    <SeekBar
        android:id="@+id/gpu_seekbar_default_pwrlevel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/spinner_stroke"
        android:thumbTint="@color/accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/gpu_pwrlevel_fast"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="0 · fastest" />

        <TextView
            android:id="@+id/gpu_pwrlevel_slow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="7 · slowest" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/freq_gpu_throttling_label"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/switch_gpu_throttling"
            android:thumbTint="@color/switch_thumb"
            android:trackTint="@color/switch_track"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

</LinearLayout>
