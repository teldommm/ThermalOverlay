<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fps_chart_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fps_chart_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/chart_record_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_button_start"
            android:textColor="#0a1f18"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:elevation="0dp"
            android:text="@string/fps_chart_start_recording" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chart_sessions"
                android:layout_width="match_parent"
                android:layout_height="220dp" />

            <TextView
                android:id="@+id/chart_sessions_empty"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:gravity="center"
                android:text="@string/fps_chart_no_sessions"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chart_session_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Header: Platform / Model / OS / Profile, mirroring Scene's
                 chart_info row. Scene shows an icon above each; we show the
                 value text only (no icon assets ported). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Platform" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:id="@+id/chart_platform" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Model" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:id="@+id/chart_phone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OS" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:id="@+id/chart_os" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profile" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:id="@+id/chart_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Scene: app icon + recording time on the left (baseline-
                 aligned), app name right-aligned — matches session_logo/
                 chart_session_time/chart_session_name in
                 activity_fps_session.xml exactly (its chart_view_size
                 neighbor is dead code in the real app too, nothing ever
                 sets it, so it's not ported). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/session_logo"
                    android:layout_width="22dp"
                    android:layout_height="22dp" />

                <TextView
                    android:id="@+id/chart_session_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-condensed-light" />

                <TextView
                    android:id="@+id/chart_session_name"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MAX" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:id="@+id/chart_fps_max" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0" android:textColor="@color/accent" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FPS" android:textColor="@color/text_secondary" android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MIN" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:id="@+id/chart_fps_min" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0" android:textColor="@color/accent" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FPS" android:textColor="@color/text_secondary" android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AVG" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:id="@+id/chart_fps_avg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0" android:textColor="@color/accent" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FPS" android:textColor="@color/text_secondary" android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VARIANCE" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:id="@+id/chart_fps_variance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0" android:textColor="@color/accent" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FPS" android:textColor="@color/text_secondary" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u226545FPS" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:id="@+id/chart_smooth_ratio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0%" android:textColor="@color/accent" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/fps_chart_smooth_label" android:textColor="@color/text_secondary" android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5% Low" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:id="@+id/chart_low_fps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/accent" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FPS" android:textColor="@color/text_secondary" android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MAX" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:id="@+id/chart_temp_max" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0\u2103" android:textColor="@color/accent" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/fps_chart_temp_label" android:textColor="@color/text_secondary" android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AVG" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:id="@+id/chart_power_avg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textColor="@color/accent" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Power(W)" android:textColor="@color/text_secondary" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="FPS"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chart_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fps_chart_dimension_temperature"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:padding="6dp" />
            </LinearLayout>

            <com.thermaloverlay.overlay.ui.FpsDataView
                android:id="@+id/chart_session_view"
                android:layout_width="match_parent"
                android:layout_height="220dp" />

            <!-- Scene's FPS legend is static — always shows all 4 possible
                 series regardless of which right-dimension is currently
                 toggled on the chart itself. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginTop="4dp">
                <TextView android:text="\u25a0 FPS" android:textSize="12sp" android:textColor="@android:color/darker_gray" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="\u25a0 TEMP(\u2103)" android:textSize="12sp" android:textColor="#80ff7e00" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
                <TextView android:text="\u25a0 CPU(%)" android:textSize="12sp" android:textColor="#80fc6bc5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
                <TextView android:text="\u25a0 GPU(%)" android:textSize="12sp" android:textColor="#87d3ff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fps_chart_section_jank"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />
            <com.thermaloverlay.overlay.ui.SessionJankChartView
                android:id="@+id/chart_jank_view"
                android:layout_width="match_parent"
                android:layout_height="140dp" />
            <!-- Scene shows session-total counts here (sum(jank)/sum(big_jank)),
                 not per-tick averages. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginTop="4dp">
                <TextView android:text="JANK:" android:textSize="11sp" android:textColor="#87d3ff" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/chart_jank_total" android:textSize="11sp" android:textColor="#87d3ff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" />
                <TextView android:text="BIG JANK:" android:textSize="11sp" android:textColor="#80fc6bc5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" />
                <TextView android:id="@+id/chart_big_jank_total" android:textSize="11sp" android:textColor="#80fc6bc5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fps_chart_section_frame_time"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />
            <com.thermaloverlay.overlay.ui.SessionJankChartView
                android:id="@+id/chart_frame_time_view"
                android:layout_width="match_parent"
                android:layout_height="140dp" />
            <!-- Scene draws a centred "MAX: <n>ms" line under the frame-time
                 chart (chart_dimension_ftime), filled by the activity. -->
            <TextView
                android:id="@+id/chart_frame_time_max"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fps_chart_section_core_loads"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />
            <com.thermaloverlay.overlay.ui.SessionMultiLineChartView
                android:id="@+id/chart_core_loads_view"
                android:layout_width="match_parent"
                android:layout_height="160dp" />
            <!-- Populated in Kotlin from CpuFrequencyUtils.getClusterInfo() —
                 device-specific per-cluster core ranges, colored to match
                 each cluster's line, plus the "Total" swatch (always shown
                 even though we don't draw that line, matching the source). -->
            <TextView
                android:id="@+id/chart_core_loads_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chart_cluster_freq_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fps_chart_section_cluster_freq"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />
            <com.thermaloverlay.overlay.ui.SessionMultiLineChartView
                android:id="@+id/chart_cluster_freq_view"
                android:layout_width="match_parent"
                android:layout_height="160dp" />
            <!-- Real app toggles CpuFrequencyView<->CpuFrequencyStat in place
                 via a stat icon (cpu_freq_stat); we don't have that icon
                 asset, so the title itself is tappable instead. Histogram
                 starts hidden, matching the source's own default. -->
            <com.thermaloverlay.overlay.ui.CpuFrequencyStatView
                android:id="@+id/chart_cluster_freq_stat_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="160dp" />
            <TextView
                android:id="@+id/chart_cluster_freq_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fps_chart_section_core_cycles"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />
            <com.thermaloverlay.overlay.ui.SessionMultiLineChartView
                android:id="@+id/chart_core_cycles_view"
                android:layout_width="match_parent"
                android:layout_height="160dp" />
            <!-- Same per-cluster labels as chart_core_loads_legend, plus a
                 trailing TEMP(℃) swatch for the dual-axis temperature line. -->
            <TextView
                android:id="@+id/chart_core_cycles_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fps_chart_section_gpu_load"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />
            <com.thermaloverlay.overlay.ui.SessionLineChartView
                android:id="@+id/chart_gpu_load_view"
                android:layout_width="match_parent"
                android:layout_height="140dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginTop="4dp">
                <TextView android:text="\u25a0 Frequency(MHz)" android:textSize="12sp" android:textColor="#87d3ff" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="\u25a0 Usage(%)" android:textSize="12sp" android:textColor="#1474e4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fps_chart_section_ddr"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />
            <com.thermaloverlay.overlay.ui.SessionLineChartView
                android:id="@+id/chart_ddr_view"
                android:layout_width="match_parent"
                android:layout_height="140dp" />

            <!-- Real app: one FrameLayout (chart_power) with two overlaid
                 cards (chart_power_mA = BatteryIOView, chart_power_w =
                 PowerView) swapped via chart_toggle_w, Battery Current
                 hidden by default. Ported here as one tappable title (same
                 pattern as chart_cluster_freq_title above) toggling both
                 the SessionLineChartView.kind AND the title text, instead
                 of two separate view instances — same visual result. -->
            <TextView
                android:id="@+id/chart_power_toggle_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fps_chart_section_power"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />
            <com.thermaloverlay.overlay.ui.SessionLineChartView
                android:id="@+id/chart_power_view"
                android:layout_width="match_parent"
                android:layout_height="140dp" />
            <!-- Legend + MAX/MIN/AVG both swap with the toggle above (real
                 app: chart_battery_legend vs chart_power_legend,
                 battery_io_max/min/avg vs power_max/min/avg) — populated in
                 Kotlin since which set applies depends on showingBatteryCurrent. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginTop="4dp">
                <TextView android:id="@+id/chart_power_legend_left" android:textSize="12sp" android:textColor="#1474e4" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/chart_power_legend_right" android:text="\u25a0 Capacity(%)" android:textSize="12sp" android:textColor="#87d3ff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp">
                <TextView android:text="MAX:" android:textSize="11sp" android:textColor="#a0808080" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/chart_power_max" android:textSize="11sp" android:textColor="#a0808080" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" />
                <TextView android:text="MIN:" android:textSize="11sp" android:textColor="#a0808080" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" />
                <TextView android:id="@+id/chart_power_min" android:textSize="11sp" android:textColor="#a0808080" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" />
                <TextView android:text="AVG:" android:textSize="11sp" android:textColor="#a0808080" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" />
                <TextView android:id="@+id/chart_power_avg_row" android:textSize="11sp" android:textColor="#a0808080" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" />
            </LinearLayout>

            <!-- Scene puts CPU Temperature last, after Power/Battery Current
                 (chart_cpu_t is the final BlurViewRelativeLayout card in
                 activity_fps_session.xml) — order kept exactly. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fps_chart_section_cpu_temp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />
            <com.thermaloverlay.overlay.ui.SessionLineChartView
                android:id="@+id/chart_cpu_temp_view"
                android:layout_width="match_parent"
                android:layout_height="140dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp">
                <TextView android:text="MAX:" android:textSize="11sp" android:textColor="#a0808080" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/chart_cpu_temp_max_row" android:textSize="11sp" android:textColor="#a0808080" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" />
                <TextView android:text="MIN:" android:textSize="11sp" android:textColor="#a0808080" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" />
                <TextView android:id="@+id/chart_cpu_temp_min" android:textSize="11sp" android:textColor="#a0808080" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" />
                <TextView android:text="AVG:" android:textSize="11sp" android:textColor="#a0808080" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" />
                <TextView android:id="@+id/chart_cpu_temp_avg" android:textSize="11sp" android:textColor="#a0808080" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
