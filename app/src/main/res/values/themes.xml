<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ThermalOverlay" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorAccent">@color/accent</item>

        <!-- The system bars take the app background instead of the default
             black, so there is no black strip above and below the content
             (and the gesture handle sits on the app's own colour). Icons stay
             light because the background is dark. -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <!-- 3-button navigation: no separator line between content and bar. -->
        <item name="android:navigationBarDividerColor" tools:targetApi="28">@color/bg_dark</item>
        <!-- Android 10+ otherwise paints its own contrast scrim over the bar
             when it is transparent/matching; we want exactly our colour. -->
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>

        <!-- Open dropdown lists: only the row's own rounded highlight is drawn. -->
        <item name="dropDownListViewStyle">@style/Widget.ThermalOverlay.DropDownList</item>
    </style>

    <!-- The default list selector paints a square highlight over the pressed
         row, on top of the rounded one from bg_spinner_item (two effects at
         once). The rows draw their own state, so the selector is transparent. -->
    <style name="Widget.ThermalOverlay.DropDownList" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:listSelector">@android:color/transparent</item>
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
    </style>
</resources>
