<resources>
    <!-- HUD ring states (CPU/GPU load, battery). Normal use is blue; idle is
         light green; high load orange; critical red. Tuned for the slate HUD
         background. Names are historical: low = idle, mid = normal. -->
    <color name="color_load_low">#5FD98B</color>
    <color name="color_load_mid">#3B8CF5</color>
    <color name="color_load_hight">#FF9F3D</color>
    <color name="color_load_veryhight">#FF5D52</color>
    <color name="color_load_critical">#FF3B30</color>

    <!-- CPU / GPU load rings: one cool-to-hot ramp. Idle is a light sky blue,
         the same hue family as normal use (blue), so the two read as one
         palette; high load turns orange, saturation red. The battery ring
         keeps the color_load_* set above. -->
    <color name="ring_load_low">#62BAF7</color>
    <color name="ring_load_mid">#3B8CF5</color>
    <color name="ring_load_hight">#FF9F3D</color>
    <color name="ring_load_veryhight">#FF5D52</color>

    <!-- HUD surface and text -->
    <color name="hud_bg">#CC393E46</color>
    <color name="hud_stroke">#B3262A31</color>
    <color name="hud_ring_track">#6B7078</color>
    <color name="hud_text_primary">#FFFFFF</color>
    <color name="hud_text_secondary">#B9BEC5</color>
    <color name="hud_text_muted">#9096A0</color>

    <color name="bg_dark">#121212</color>
    <color name="surface_dark">#1e1e1e</color>
    <color name="accent">#02d98d</color>
    <color name="danger">#f9592f</color>
    <color name="warning_bg_solid">#3d2e14</color>
    <color name="warning_text">#ffb74d</color>
    <color name="text_primary">#ffffff</color>
    <color name="text_secondary">#99ffffff</color>

    <!-- Dropdown lists (governor / frequency pickers) -->
    <color name="spinner_bg">#262626</color>
    <color name="spinner_stroke">#33ffffff</color>
    <color name="popup_bg">#2b2b2b</color>
    <color name="accent_soft">#2602d98d</color>
    <color name="press_soft">#1fffffff</color>
    <color name="card_stroke">#14ffffff</color>
</resources>
