<resources>
    <!-- Battery ring states. Normal is blue, a cold battery is a light ice
         blue; warm / low charge orange; hot red. Tuned for the slate HUD
         background. Names are historical: low = cold, mid = normal. -->
    <color name="color_load_low">#7CC4FA</color>
    <color name="color_load_mid">#3B8CF5</color>
    <color name="color_load_hight">#FF9F3D</color>
    <color name="color_load_veryhight">#FF5D52</color>
    <color name="color_load_critical">#FF3B30</color>

    <!-- CPU / GPU load rings: blue only. Load grows from a light sky blue
         through the normal blue to deeper royal blue and indigo. Every stop
         stays bright enough to read against the gray ring track. The battery
         ring keeps the color_load_* set above. -->
    <color name="ring_load_low">#7CC4FA</color>
    <color name="ring_load_mid">#3B8CF5</color>
    <color name="ring_load_hight">#3F74F7</color>
    <color name="ring_load_veryhight">#4F63F5</color>

    <!-- HUD surface and text -->
    <color name="hud_bg">#CC393E46</color>
    <color name="hud_stroke">#CC2F343B</color>
    <color name="hud_ring_track">#6B7078</color>
    <color name="hud_text_primary">#FFFFFF</color>
    <color name="hud_text_secondary">#B9BEC5</color>
    <color name="hud_text_muted">#9096A0</color>

    <!-- App screens: the same slate-and-blue palette as the HUD. Cards use the
         HUD's own slate with its dark outline; inputs sit recessed inside
         them; the accent is the HUD's blue. -->
    <color name="bg_dark">#262A30</color>
    <color name="surface_dark">#393E46</color>
    <color name="accent">#3B8CF5</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="danger">#FF5D52</color>
    <color name="warning_bg_solid">#463A28</color>
    <color name="warning_stroke">#6B5433</color>
    <color name="warning_text">#FF9F3D</color>
    <color name="button_disabled">#664A515B</color>
    <color name="text_primary">#ffffff</color>
    <color name="text_secondary">#B9BEC5</color>

    <!-- Dropdown lists (governor / frequency pickers) -->
    <color name="spinner_bg">#2F343B</color>
    <color name="spinner_stroke">#525963</color>
    <color name="popup_bg">#444A53</color>
    <color name="accent_soft">#333B8CF5</color>
    <color name="press_soft">#1fffffff</color>
    <color name="card_stroke">#2F343B</color>
</resources>
